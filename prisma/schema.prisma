// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  SERVEUR
  CUISINE
  CAISSIER
  COMPTABILITE
  LIVREUR
}

// Comment la commande est servie. Distinct de OrderSource, qui dit d'où elle vient :
// une commande prise en ligne peut être à emporter comme livrée.
enum OrderType {
  SUR_PLACE
  A_EMPORTER
  LIVRAISON
}

enum DeliveryStatus {
  A_ASSIGNER
  ASSIGNEE
  EN_ROUTE
  LIVREE
  ECHOUEE
}

enum OrderStatus {
  EN_ATTENTE
  EN_PREPARATION
  PRETE
  SERVIE
  ANNULEE
}

enum OrderSource {
  INTERNE
  EN_LIGNE
}

enum PaymentMethod {
  CASH
  WAVE
}

enum CashRegisterStatus {
  OUVERTE
  FERMEE
}

// Comment se compte un produit en stock. Les quantités sont décimales : 0,5 KG
// vaut 500 g, inutile de multiplier les sous-unités.
enum StockUnit {
  KG
  LITRE
  UNITE
}

enum StockMovementType {
  ACHAT // entrée : la comptabilité approvisionne le stock chez un fournisseur
  PRODUCTION // entrée : la maison a préparé le produit elle-même
  SORTIE // sortie : la comptabilité remet des produits à la cuisine
  AJUSTEMENT // correction d'inventaire, dans un sens ou dans l'autre
}

model User {
  id                     String         @id @default(cuid())
  name                   String
  email                  String         @unique
  password               String
  role                   Role           @default(SERVEUR)
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  orders                 Order[]
  deliveries             Order[]        @relation("OrderLivreur")
  expenses               Expense[]
  stockMovements         StockMovement[]
  payments               Payment[]
  correctedPayments      Payment[]      @relation("PaymentMethodCorrector")
  cashRegisters          CashRegister[] @relation("CashRegisterCashier")
  correctedCashRegisters CashRegister[] @relation("CashRegisterCorrector")
  openingHours           OpeningHour[]
  closures               ExceptionalClosure[]
  cancelledOrders        Order[]              @relation("OrderCanceller")
  correctedStockMovements StockMovement[]     @relation("StockMovementCorrector")
  cashCounts             CashCount[]
}

// Zone de livraison : un tarif unique pour tous les quartiers qu'elle regroupe.
model DeliveryZone {
  id        String     @id @default(cuid())
  name      String     @unique
  fee       Float
  active    Boolean    @default(true)
  quartiers Quartier[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Un quartier n'appartient qu'à une seule zone : c'est lui que choisit le client,
// et c'est de lui que découle le prix de la livraison.
model Quartier {
  id     String       @id @default(cuid())
  name   String       @unique
  zoneId String
  zone   DeliveryZone @relation(fields: [zoneId], references: [id])
  orders Order[]

  @@index([zoneId])
}

model MenuCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  items MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  price       Float
  available   Boolean      @default(true)
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  // Produit revendu tel quel : le client consomme ce qui a été acheté, sans
  // transformation. La vente le sort donc du stock d'elle-même. Reste nul pour un
  // plat cuisiné, dont les ingrédients sortent vers la cuisine par lots, et non à
  // la commande — une part de mafé ne se convertit pas en kilos de riz.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  // Ce qu'une vente retire du stock : une bouteille, ou 0,33 L tiré d'un bidon
  // quand le produit se compte en litres et se vend au verre.
  quantiteParVente Float @default(1)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  // Code court communiqué au client pour suivre sa commande. Tiré au hasard
  // plutôt que séquentiel : un numéro qui s'incrémente se devine, et donnerait
  // accès au nom, au téléphone et à l'adresse des autres clients.
  reference     String?     @unique
  tableNumber   Int?
  status        OrderStatus @default(EN_ATTENTE)
  source        OrderSource @default(INTERNE)
  type          OrderType   @default(SUR_PLACE)
  customerName  String?
  customerPhone String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payment       Payment?
  // Sorties de stock qu'a entraînées la vente d'articles revendus tels quels.
  stockMovements StockMovement[]

  // Livraison à domicile
  deliveryAddress String?
  deliveryNote    String?
  quartierId      String?
  quartier        Quartier?       @relation(fields: [quartierId], references: [id])
  // Frais figés au moment de la commande : changer le tarif d'une zone ne doit
  // pas réécrire le prix des livraisons déjà passées.
  deliveryFee     Float?

  // Paiement Wave annoncé par le client depuis le site. Ce n'est pas un
  // encaissement : la caisse doit vérifier la réception dans Wave avant de
  // valider. Seul un Payment fait foi.
  waveDeclaredAt DateTime?
  waveReference  String?
  deliveryStatus  DeliveryStatus?
  livreurId       String?
  livreur         User?           @relation("OrderLivreur", fields: [livreurId], references: [id])
  assignedAt      DateTime?
  deliveredAt     DateTime?

  // Annulation par la comptabilité — commande jamais encaissée dont le client
  // est injoignable, canular, doublon ; ou commande déjà encaissée qu'il faut
  // défaire. La commande quitte alors la liste des encaissements en attente,
  // mais n'est pas détruite : le motif doit rester attaché à ce qu'il justifie,
  // sans quoi plus personne ne peut vérifier après coup ce qui a disparu de la
  // journée, ni constater une annulation à tort.
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledById      String?
  cancelledBy        User?     @relation("OrderCanceller", fields: [cancelledById], references: [id])

  // Remboursement rendu au client quand l'annulation portait sur une commande
  // déjà encaissée. Son absence sur une commande annulée dit que la maison a
  // gardé l'argent — les deux arrivent, et rien ne permettrait de les
  // distinguer si le remboursement n'était qu'une dépense parmi d'autres.
  refund Expense? @relation("OrderRefund")

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([deliveryStatus])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float
  note       String?
}

model Expense {
  id        String   @id @default(cuid())
  label     String
  amount    Float
  category  String
  date      DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // Renseigné quand la dépense a été engendrée par un achat de stock. Elle est
  // alors pilotée par le mouvement : on ne la saisit ni ne la supprime à part.
  stockMovement StockMovement?

  // Renseigné quand la dépense rend au client l'argent d'une commande annulée
  // après encaissement. Le paiement d'origine, lui, n'est jamais effacé : la
  // recette du jour où il a eu lieu a déjà été comptée, versée et vérifiée, et
  // la réécrire creuserait dans un versement clos un écart que plus personne ne
  // pourrait expliquer. L'argent ressort donc au jour où il est rendu, comme
  // toute sortie de caisse.
  refundedOrderId String? @unique
  refundedOrder   Order?  @relation("OrderRefund", fields: [refundedOrderId], references: [id])

  // Renseigné quand un caissier a réglé la dépense en espèces depuis son tiroir.
  // Ce lien n'est pas décoratif : il retire la somme des espèces attendues à la
  // clôture, et la réintègre dans la recette pour qu'elle ne soit pas décomptée
  // deux fois — une fois par le versement amoindri, une fois comme dépense.
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])

  // Avec quoi la maison a réglé la dépense. Sans cette colonne, le calcul du
  // coffre supposait que toute dépense hors tiroir sortait des espèces : une
  // dépense payée en Wave vidait donc un coffre qu'elle n'avait jamais touché,
  // pendant que le compte Wave gardait un argent déjà sorti.
  //
  // Nul pour les dépenses saisies avant que la question ne soit posée. Ce n'est
  // pas « espèces » : c'est « on ne sait pas ». Le calcul les traite comme des
  // espèces, faute de mieux, et l'écran dit que c'en est l'hypothèse — mettre
  // CASH par défaut ferait passer cette hypothèse pour une réponse.
  method PaymentMethod?

  @@index([cashRegisterId])
}

// Produit consommable suivi en stock (denrée, boisson, emballage...). Distinct
// de MenuItem, qui est ce qu'on vend : on achète du riz, on vend un thiébou.
model Product {
  id          String          @id @default(cuid())
  name        String          @unique
  unit        StockUnit
  category    String          @default("Ingrédients")
  // Préparé par la maison — jus pressés, thiakry, lakh — et non acheté tout fait.
  // Un tel produit n'a pas de prix d'achat fournisseur : ses ingrédients ont
  // déjà été achetés et passés en dépense. L'approvisionner passe donc par une
  // production, jamais par un achat, sous peine de compter deux fois la même
  // charge — une fois le riz, une fois le thiakry qu'on en a tiré.
  faitMaison  Boolean         @default(false)
  // En dessous de ce niveau, le produit remonte en alerte sur le tableau de bord.
  seuilAlerte Float           @default(0)
  active      Boolean         @default(true)
  movements   StockMovement[]
  // Articles du menu qui vendent ce produit tel quel.
  menuItems   MenuItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Le stock n'est jamais stocké : il est la somme des mouvements. Un solde
// dénormalisé finit toujours par diverger de son historique.
model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  // Delta signé appliqué au stock : positif en entrée, négatif en sortie. Le
  // signe est posé côté serveur d'après le type, jamais saisi par l'utilisateur.
  quantity  Float
  // Prix d'achat unitaire figé (ACHAT uniquement) : réviser un tarif ne doit pas
  // réécrire la valeur des approvisionnements déjà passés.
  unitPrice Float?
  supplier  String?
  note      String?

  // Dépense engendrée par un achat, pour que le stock et le résultat comptable
  // proviennent d'une seule saisie.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id])

  // Correction d'une saisie par la comptabilité : quantité mal frappée, prix
  // d'achat erroné. Les valeurs d'origine sont conservées — sans elles, plus
  // rien ne distingue une saisie juste d'une saisie rectifiée, et l'écart de
  // stock ou de dépense qu'elle a provoqué devient inexplicable. Comme pour la
  // correction d'un mode de paiement, seule la toute première correction les
  // renseigne, pour qu'un aller-retour ne les efface pas.
  originalQuantity  Float?
  originalUnitPrice Float?
  correctionNote    String?
  correctedById     String?
  correctedBy       User?     @relation("StockMovementCorrector", fields: [correctedById], references: [id])
  correctedAt       DateTime?

  // Sortie engendrée par la vente d'un article revendu tel quel — une bouteille,
  // un jus, une gâterie. Le mouvement est piloté par la commande : il naît avec
  // elle, la suit quand on la modifie et disparaît quand elle est annulée. Il ne
  // se saisit ni ne se rectifie à la main, sous peine de faire diverger le stock
  // de ce qui a réellement été vendu.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  date      DateTime @default(now())
  // Nul pour une sortie engendrée par une commande en ligne : personne ne l'a
  // saisie, c'est la vente qui en répond. La commande tient alors lieu d'auteur.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([date])
  @@index([orderId])
}

// Session de caisse ouverte par un caissier pour sa journée de travail.
// Sa fermeture constitue le versement (remise des espèces à la comptabilité).
model CashRegister {
  id        String              @id @default(cuid())
  cashierId String
  cashier   User                @relation("CashRegisterCashier", fields: [cashierId], references: [id])
  status    CashRegisterStatus  @default(OUVERTE)
  openedAt  DateTime            @default(now())
  closedAt  DateTime?

  openingFloat   Float  @default(0) // fond de caisse au démarrage
  totalCash      Float? // total encaissé en espèces (calculé à la fermeture)
  totalWave      Float? // total encaissé via Wave (calculé à la fermeture)
  declaredAmount Float? // espèces comptées dans le tiroir et versées par le caissier (fond de caisse inclus)
  expectedCash   Float? // espèces théoriquement présentes : fond de caisse + encaissements cash
  difference     Float? // declaredAmount - expectedCash : négatif = manquant, positif = excédent
  note           String?

  // Correction éventuelle par la comptabilité (l'historique original reste inchangé ci-dessus)
  correctedAmount Float?
  correctionNote  String?
  correctedById   String?
  correctedBy     User?     @relation("CashRegisterCorrector", fields: [correctedById], references: [id])
  correctedAt     DateTime?

  payments  Payment[]
  // Dépenses courantes réglées en espèces depuis ce tiroir pendant le service.
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

// Comptage de la caisse tenue par la comptabilité : les espèces réellement
// présentes dans le coffre à un instant donné.
//
// Cette caisse-là ne se ferme jamais, contrairement au tiroir d'un caissier qui
// ne vit qu'une journée : elle reçoit les versements du soir et paie les achats
// du lendemain, d'un mois sur l'autre. Son disponible n'est donc pas stocké —
// comme le stock, il est la somme de ce qui entre et de ce qui sort depuis le
// dernier comptage. Un solde entretenu à la main finirait par diverger des
// versements et des dépenses qui le composent.
//
// Un comptage sert alors à deux choses : amorcer la caisse, quand l'argent déjà
// dans le coffre ne provient d'aucun versement enregistré — un démarrage, un
// report de l'exercice précédent — et la recaler après un comptage physique.
// Seul le plus récent fait foi ; les précédents restent, car un recalage sans
// trace ne se vérifie plus.
model CashCount {
  id String @id @default(cuid())

  // Instant du comptage : tout ce qui entre ou sort du coffre à partir de là
  // s'ajoute au montant compté. Saisi au jour, il vaut minuit — l'état du coffre
  // au matin — car c'est la résolution des dépenses, elles aussi datées au jour.
  countedAt DateTime
  amount    Float
  note      String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([countedAt])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id])
  amount         Float
  method         PaymentMethod
  cashierId      String
  cashier        User          @relation(fields: [cashierId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister  @relation(fields: [cashRegisterId], references: [id])
  createdAt      DateTime      @default(now())

  // Correction du mode de paiement par la comptabilité, quand le caissier s'est
  // trompé de touche. Le mode d'origine est conservé : sans lui, plus rien ne
  // distingue une saisie juste d'une saisie corrigée, et l'écart de caisse
  // qu'elle a provoqué devient inexplicable. Seule la toute première correction
  // le renseigne, pour qu'un aller-retour ne l'efface pas.
  originalMethod       PaymentMethod?
  methodCorrectionNote String?
  methodCorrectedById  String?
  methodCorrectedBy    User?          @relation("PaymentMethodCorrector", fields: [methodCorrectedById], references: [id])
  methodCorrectedAt    DateTime?
}

// Heures d'ouverture de la commande en ligne, un enregistrement par jour de la
// semaine. C'est la seule chose qu'elles gouvernent : le service en salle et la
// prise de commande au comptoir n'en dependent pas, un client attable a 23h30
// doit toujours pouvoir etre encaisse.
//
// Les heures sont stockees en minutes depuis minuit plutot qu'en texte : la
// comparaison « sommes-nous ouverts ? » se fait alors sur deux entiers, sans
// analyser « 08:00 » a chaque commande ni dependre d'un format local.
model OpeningHour {
  id String @id @default(cuid())

  // 0 = dimanche … 6 = samedi, comme `Date.getDay()`, pour qu'aucune conversion
  // ne s'intercale entre l'heure du serveur et la ligne lue ici.
  weekday Int @unique

  closed   Boolean @default(false)
  opensAt  Int     @default(480)
  closesAt Int     @default(1380)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}

// Fermeture exceptionnelle : un jour ferie, des conges, une fermeture technique.
// Elle prime sur la grille hebdomadaire — un 4 avril tombant un mardi ferme la
// commande en ligne meme si tous les mardis sont ouverts.
//
// Les bornes sont des jours de calendrier, pas des instants, et sont donc
// stockees en `YYYY-MM-DD` plutot qu'en DateTime. Un DateTime porterait une heure
// et un fuseau : « ferme le 15 aout » deviendrait « ferme du 14 a 23h au 15 a
// 23h » des que le serveur et la base ne s'accordent pas sur minuit. Un texte
// ISO se compare tel quel, dans l'ordre alphabetique, et ne se decale jamais.
model ExceptionalClosure {
  id String @id @default(cuid())

  /// Premier et dernier jour fermes, tous deux inclus. Une fermeture d'un seul
  /// jour porte la meme valeur des deux cotes.
  startDate String
  endDate   String

  /// Montre au client tel quel : « Tabaski », « Congés annuels ». Facultatif —
  /// un restaurant ne doit pas justifier sa fermeture pour pouvoir la declarer.
  reason String?

  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([startDate])
}
