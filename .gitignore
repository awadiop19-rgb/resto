# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite database (local dev data, never commit)
*.db
*.db-journal
*.db-wal
*.db-shm
# Sauvegardes laissées par prisma/copier-bd-prod.ts : dev.db.avant-2026-08-01T...
*.db.avant-*
prisma/*.db
prisma/*.db-journal

# photos du menu envoyées depuis l'application (données, pas source)
/photos-menu/

# build/log artifacts
build-output.txt
build-run.log
